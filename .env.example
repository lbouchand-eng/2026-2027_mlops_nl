# Copier en .env (ignoré par git). Aucun secret requis pour l’instant.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Optionnel : protège POST /reload (en-tête X-API-Key). Vide = pas de contrôle.
PGA_API_KEY=
# Optionnel : webhook (format Slack) prévenu des alertes de monitoring et des actions du déclencheur.
PGA_ALERT_WEBHOOK=
