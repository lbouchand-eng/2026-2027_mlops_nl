      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pga_drift_status{job=\"pga_monitor\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true,
